---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { withBase } from '../lib/site';

const linkHref = (href: string) => (href.startsWith('http') ? href : withBase(href));
---

<Base title={`The Tackle-Box Don — ${site.displayName}`} description={`The character profile of ${site.displayName}: the Tackle-Box Don of Ul'dah, angler, information broker, and boss of the Sinker & Line.`}>
  <h1>The Tackle-Box Don</h1>

  {site.about.intro.map((paragraph) => <p set:html={paragraph} />)}

  <blockquote>{site.about.quote}</blockquote>

  <h2>Vital Statistics</h2>
  <table class="retro-table">
    <thead>
      <tr><th scope="col">Field</th><th scope="col">Detail</th></tr>
    </thead>
    <tbody>
      {
        site.about.specs.map((item) => (
          <tr>
            <td>{item.label}</td>
            <td>{item.value}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2>Personality &amp; Traits</h2>

  {site.about.personality.map((paragraph) => <p set:html={paragraph} />)}

  <h2>Preferences</h2>
  <table class="retro-table">
    <tbody>
      {
        site.about.favorites.map((item) => (
          <tr>
            <th scope="row" style="width:34%">{item.label}</th>
            <td>{item.value}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2>The Story So Far</h2>

  {
    site.about.story.map((section) => (
      <section class="story-section">
        <h3>{section.title}</h3>
        {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
      </section>
    ))
  }

  <h2>Associates &amp; Neighbors</h2>
  <ul>
    {
      site.about.friends.map((friend) => (
        <li>
          <a href={linkHref(friend.href)} target={friend.href.startsWith('http') ? '_blank' : undefined} rel={friend.href.startsWith('http') ? 'noreferrer' : undefined}>
            {friend.label}
          </a>{' '}
          &mdash; {friend.note}
        </li>
      ))
    }
  </ul>

  <p class="center" style="margin-top:24px">
    <a href={withBase('/')}>&laquo; Back to the homepage</a> &middot;
    <a href={withBase('/blog/')}>Read the dispatches</a>
  </p>
</Base>
