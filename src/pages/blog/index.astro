---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../../site.config';
import { formatDate, postUrl, withBase } from '../../lib/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title={`Dispatches — ${site.displayName}`} description={`Dispatches from the Sinker & Line: six field notes from ${site.displayName}, the Tackle-Box Don of Ul'dah.`}>
  <h1>Dispatches</h1>
  <p>
    Field notes from the Sinker &amp; Line. {posts.length} entries so far.
    Some names have been changed. The fish have not. Updated {site.updated}.
  </p>

  <ul class="post-list">
    {
      posts.map((entry) => (
        <li>
          <span class="post-date">{formatDate(entry.data.date)}</span>
          <a class="post-title" href={postUrl(entry.id)}>{entry.data.title}</a>
          <p>{entry.data.description}</p>
        </li>
      ))
    }
  </ul>

  <p class="center" style="margin-top:20px">
    <a href={withBase('/')}>&laquo; Back to the homepage</a>
  </p>
</Base>
